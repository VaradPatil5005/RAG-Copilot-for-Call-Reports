# ==============================================================================
# Tathyx AI - Web Environment Configuration
# Copy to .env.local (gitignored). Never commit real values.
# ==============================================================================

# Database Connection (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Auth.js secret -- ALSO used to sign API tokens for the FastAPI backend, so it
# must be identical to AUTH_SECRET in apps/api/.env. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Production refuses to start with a missing/short/default value.
AUTH_SECRET=""

# Base Next.js URL
NEXTAUTH_URL="http://localhost:3000"

# Backend API endpoint (read by src/lib/api.ts and allowed in the CSP)
NEXT_PUBLIC_API_BASE="http://localhost:8000"

# CAPTCHA (Cloudflare Turnstile) -- free keys at https://dash.cloudflare.com/?to=/:account/turnstile
# Leave empty in local dev to use Cloudflare's always-pass TEST keys.
# REQUIRED in production: login/sign-up are refused if the secret is missing.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Show the OTP on screen / in the server log instead of sending an SMS.
# Ignored when NODE_ENV=production (real SMS via Twilio is then required).
OTP_DEV_MODE=true

# One-click demo accounts on the login page (seeded by prisma/seed.ts).
# Ignored when NODE_ENV=production.
NEXT_PUBLIC_ENABLE_DEMO_LOGINS=false

# Set to true ONLY when running behind a reverse proxy / CDN that overwrites
# X-Forwarded-For (Vercel, Cloudflare, nginx...). Otherwise clients could
# spoof their IP to dodge rate limits.
TRUST_PROXY_HEADERS=false

# Google OAuth (Optional: populate from Google Cloud Console for 1-click login)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Twilio SMS (required for real OTP delivery in production)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
