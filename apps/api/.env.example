# Copy to .env (already gitignored -- see .gitignore) and fill in whichever
# free-tier provider you're using. Never commit a real key. See
# docs/decisions/0005-generation-model-choice.md for how these are compared
# and what each free tier currently allows.

# "auto" (default) tries Gemini, then Groq, then a local Ollama daemon, then
# falls back to the deterministic extractive provider if none are reachable.
# Set explicitly to force one: gemini | groq | ollama | extractive
LLM_PROVIDER=auto

# Option B (recommended default) -- https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Option C -- https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Option A -- local Ollama daemon, no key needed
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Auth (Phase 6.3) ---------------------------------------------------
# Local-dev substitute for the enterprise IdP (Azure AD/Entra ID in a real
# deployment) -- see app/services/auth.py and docs/decisions/0007. Set a
# real random value for AUTH_SECRET in any shared/non-throwaway environment;
# the default is intentionally insecure and only for a single-developer
# local sandbox. Set AUTH_DEV_MODE=false to disable /auth/dev-token
# entirely once a real IdP is fronting this API.
AUTH_SECRET=local-dev-insecure-secret-do-not-use-in-production
AUTH_DEV_MODE=true
AUTH_TOKEN_TTL_SECONDS=3600
