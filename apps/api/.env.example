# Copy to .env (already gitignored -- see .gitignore) and fill in whichever
# free-tier provider you're using. Never commit a real key. See
# docs/decisions/0005-generation-model-choice.md for how these are compared
# and what each free tier currently allows.

# "auto" (default) tries Gemini, then Groq, then a local Ollama daemon, then
# falls back to the deterministic extractive provider if none are reachable.
# Set explicitly to force one: gemini | groq | ollama | extractive
LLM_PROVIDER=auto

# Option B (recommended default) -- https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Option C -- https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Option A -- local Ollama daemon, no key needed
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Auth ----------------------------------------------------------------
# AUTH_SECRET verifies every API token. It MUST equal AUTH_SECRET in
# apps/web/.env.local (the web app signs tokens with it). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The API refuses to start with the default/short secret unless
# AUTH_DEV_MODE=true, and refuses AUTH_DEV_MODE=true when APP_ENV=production.
AUTH_SECRET=
# AUTH_DEV_MODE=true enables POST /auth/dev-token, which mints a token for
# ANY tenant/role. Local experiments only -- never on a reachable server.
AUTH_DEV_MODE=false
AUTH_TOKEN_TTL_SECONDS=900
AUTH_AUDIENCE=tathyx-api

# --- Deployment hardening ---------------------------------------------------
# development | production  (production disables /docs and enables HSTS)
APP_ENV=development
# Comma-separated browser origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_UPLOADS_PER_MINUTE=10
# true only behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false
# Where raw files, derived files, the SQLite DB and the index live.
# TATHYX_DATA_DIR=./data
